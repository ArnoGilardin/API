# Application
APP_NAME=B2B Lead Generation API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY=your-api-key-here

# Database
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=leadgen_password_change_me
POSTGRES_DB=leadgen_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Scraping Settings
USER_AGENT=LeadGenBot/1.0 (+https://yourapi.com/bot)
CONCURRENT_REQUESTS=2
DOWNLOAD_DELAY=2
RANDOMIZE_DOWNLOAD_DELAY=True
RESPECT_ROBOTS_TXT=True

# Proxy Settings (comma-separated list)
PROXY_LIST=

# Email Verification
SMTP_TIMEOUT=10
SMTP_VERIFY_ENABLED=True
EMAIL_VERIFICATION_FROM=verify@yourapi.com

# Rate Limiting
RATE_LIMIT_PER_DAY=1000
RATE_LIMIT_PER_HOUR=100

# GDPR Settings
DATA_RETENTION_DAYS=1095
AUTO_DELETE_ENABLED=True

# Export Settings
MAX_EXPORT_RECORDS=10000

# Logging
LOG_LEVEL=INFO
